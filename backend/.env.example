# Copia este archivo como ".env" y completa los valores reales.
# NUNCA subas tu archivo ".env" real al repositorio (ya esta en .gitignore).

# Puerto en el que correra la API
PORT=3000

# Origen permitido para CORS (URL del frontend). Usa "*" solo en desarrollo.
CORS_ORIGIN=http://localhost:8080

# Secreto para firmar los JSON Web Tokens (usa una cadena larga y aleatoria)
JWT_SECRET=cambia_este_valor_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------
# Conexion a Oracle Database (Oracle APEX usa la misma base de datos)
# node-oracledb corre en modo "thin" por defecto: NO necesita instalar
# Oracle Instant Client, solo estos tres datos de conexion.
# ---------------------------------------------------------------------
ORACLE_USER=tu_usuario_oracle
ORACLE_PASSWORD=tu_password_oracle
# Formato: host:puerto/service_name  (Oracle Cloud Autonomous DB, APEX, etc.)
ORACLE_CONNECT_STRING=host:1521/servicio
